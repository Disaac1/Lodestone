{
  "game_title": "Slay the Spire",
  "default_config": {
    "characters": [
      "Ironclad",
      "Silent",
      "Defect",
      "Watcher"
    ],
    "pick_num_characters": 2,
    "num_chars_goal": 0,
    "lock_characters": "locked_random",
    "unlocked_character": "Ironclad",
    "ascension": 1,
    "final_act": false,
    "downfall": false,
    "campfire_sanity": false,
    "gold_sanity": false,
    "potion_sanity": false,
    "key_sanity": false,
    "shop_sanity": false,
    "shop_sanity_costs": "discount_tiered",
    "death_link": 0,
    "chatty_mc": true
  },
  "check_calculator": {
    "base_count": 15,
    "base_label": "Act & Boss Victories",
    "modifiers": [
      {
        "key": "campfire_sanity",
        "label": "Campfire Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "shop_sanity",
        "label": "Shop Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "gold_sanity",
        "label": "Gold Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "potion_sanity",
        "label": "Potion Sanity",
        "values": { "true": 12 }
      },
      {
        "key": "key_sanity",
        "label": "Key Sanity",
        "values": { "true": 3 }
      },
      {
        "key": "final_act",
        "label": "Act 4 Corrupt Heart",
        "values": { "true": 3 }
      }
    ]
  },
  "required_schema_keys": [
    "characters",
    "pick_num_characters",
    "num_chars_goal",
    "ascension",
    "death_link"
  ],
  "steps": [
    {
      "num": 1,
      "title": "1. Character Roster & Goals",
      "description": "Step 1: Choose character roster, heroes played, and victory condition",
      "controls": [
        {
          "type": "multi_select",
          "option_key": "characters",
          "label": "Character Pool (Select heroes allowed in your climb):",
          "columns": 4,
          "items": [
            { "id": "Ironclad", "title": "🛡️ Ironclad" },
            { "id": "Silent", "title": "🗡️ Silent" },
            { "id": "Defect", "title": "⚡ Defect" },
            { "id": "Watcher", "title": "👁️ Watcher" }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "pick_num_characters",
          "label": "Number of Characters to Pick (1 - 4):",
          "min": 1,
          "max": 4,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "slider",
          "option_key": "num_chars_goal",
          "label": "Characters Required for Victory (0 = all picked):",
          "min": 0,
          "max": 4,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "dropdown",
          "option_key": "lock_characters",
          "label": "Character Unlock Logic:",
          "choices": [
            {
              "id": "unlocked",
              "title": "🔓 All Unlocked (Play all picked heroes immediately)"
            },
            {
              "id": "locked_random",
              "title": "🎲 Locked Random (Unlock heroes via multiworld items)"
            },
            {
              "id": "locked_fixed",
              "title": "🔒 Locked Fixed (Start with 1 chosen hero below)"
            }
          ]
        },
        {
          "type": "dropdown",
          "option_key": "unlocked_character",
          "label": "Starting Unlocked Character (if Locked Fixed):",
          "condition": {
            "option_key": "lock_characters",
            "equals": "locked_fixed"
          },
          "choices": [
            { "id": "Ironclad", "title": "Ironclad" },
            { "id": "Silent", "title": "Silent" },
            { "id": "Defect", "title": "Defect" },
            { "id": "Watcher", "title": "Watcher" }
          ]
        }
      ]
    },
    {
      "num": 2,
      "title": "2. Difficulty & Acts",
      "description": "Step 2: Configure Ascension level and Act 4 Heart encounter",
      "controls": [
        {
          "type": "slider",
          "option_key": "ascension",
          "label": "Ascension Level (0 - 20):",
          "min": 0,
          "max": 20,
          "step": 1,
          "suffix": " Ascension"
        },
        {
          "type": "dropdown",
          "option_key": "final_act",
          "label": "Final Boss Encounter:",
          "choices": [
            { "id": false, "title": "👑 Act 3 Boss (Standard Victory)" },
            { "id": true, "title": "❤️ Act 4 / Corrupt Heart (Extended Run)" }
          ]
        },
        {
          "type": "toggle",
          "option_key": "downfall",
          "label": "😈 Downfall Mod Compatibility (Play as Villains if mod installed)"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Sanity Pool",
      "description": "Step 3: Check Density Presets & Individual Sanity Overrides",
      "controls": [
        {
          "type": "preset_grid",
          "columns": 3,
          "presets": [
            {
              "id": "minimal",
              "title": "🏰 Bosses & Campfires",
              "desc": "Minimal check density. Fast-paced run focused on boss relics and campfires.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": false,
                "potion_sanity": false,
                "key_sanity": false,
                "shop_sanity": false
              }
            },
            {
              "id": "standard",
              "title": "⚖️ Standard Spire",
              "desc": "Balanced multiworld with campfires, gold drops, and key sanity.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": true,
                "potion_sanity": false,
                "key_sanity": true,
                "shop_sanity": false
              }
            },
            {
              "id": "full",
              "title": "🌌 Full Sanity",
              "desc": "Everything is randomized: shops, potions, gold, keys, and campfires.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": true,
                "potion_sanity": true,
                "key_sanity": true,
                "shop_sanity": true
              }
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "campfire_sanity",
          "label": "🔥 Campfire Sanity (Shuffle Rest and Smith abilities into multiworld)"
        },
        {
          "type": "toggle",
          "option_key": "gold_sanity",
          "label": "💰 Gold Sanity (Gold rewards drop multiworld items)"
        },
        {
          "type": "toggle",
          "option_key": "key_sanity",
          "label": "🗝️ Key Sanity (Ruby, Emerald, and Sapphire Keys in item pool)"
        },
        {
          "type": "toggle",
          "option_key": "shop_sanity",
          "label": "🛒 Shop Sanity (Relics and cards in merchant shops are multiworld checks)"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Multiworld & Links",
      "description": "Step 4: Multiplayer Notifications & DeathLink",
      "controls": [
        {
          "type": "toggle",
          "option_key": "death_link",
          "label": "💀 DeathLink (Dying sends death to your multiworld partners)"
        },
        {
          "type": "toggle",
          "option_key": "chatty_mc",
          "label": "💬 Chatty MC (Broadcast chat notifications on relic & card pickups)"
        }
      ]
    }
  ]
}
