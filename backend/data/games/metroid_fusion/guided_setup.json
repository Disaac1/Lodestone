        {
          "type": "card_grid",
          "option_key": "GameMode",
          "columns": 2,
          "items": [
            {
              "id": "open_sector_hub",
              "title": "🚀 Sector Hub Navigation (Open)",
              "desc": "Main elevator access to Sectors 1-6 is open, offering nonlinear exploration across B.S.L."
            },
            {
              "id": "vanilla",
              "title": "📜 Classic Story Progression (Linear)",
              "desc": "Classic linear story progression unlocking sectors sequentially via Operations Deck orders."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "StartingLocation",
          "label": "Starting Location:",
          "choices": [
            { "id": "sector_hub", "title": "Sector Hub (Central elevator hub)" },
            { "id": "docking_bay", "title": "Docking Bay (Main Deck Gunship)" },
            { "id": "operations_deck", "title": "Operations Deck" },
            { "id": "concourse_save_station", "title": "Concourse Save Station" }
          ]
        },
        {
          "type": "toggle",
          "option_key": "OpenSectorElevators",
          "label": "🚪 Open Sector Elevators (Sector elevators unlock without keycards)"
        },
        {
          "type": "toggle",
          "option_key": "SectorTubeShuffle",
          "label": "🌀 Shuffle Sector Connection Tubes"
        },
        {
          "type": "dropdown",
          "option_key": "ElevatorShuffle",
          "label": "Elevator Shaft Shuffle:",
          "choices": [
            { "id": "none", "title": "Vanilla (Standard shaft destinations)" },
            { "id": "sectors", "title": "Shuffle Sector Hub Elevators" },
            { "id": "all", "title": "Shuffle All Station Elevators" }
          ]
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Win Condition (Infant Metroids)",
      "description": "Step 3: Infant Metroid rescue requirements and goal locations",
      "controls": [
        {
          "type": "slider",
          "option_key": "InfantMetroidsRequired",
          "label": "Infant Metroids Required for Victory:",
          "min": 1,
          "max": 20,
          "step": 1,
          "suffix": " Metroids"
        },
        {
          "type": "slider",
          "option_key": "InfantMetroidsInPool",
          "label": "Total Infant Metroids Placed in Pool:",
          "min": 1,
          "max": 20,
          "step": 1,
          "suffix": " Metroids"
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "InfantMetroidLocations",
          "label": "Infant Metroid Check Locations:",
          "choices": [
            { "id": "only_bosses", "title": "Bosses Only (Awarded exclusively by major X bosses)" },
            { "id": "bosses_encouraged", "title": "Hidden Areas & Bosses (Higher chance on bosses)" },
            { "id": "anywhere", "title": "Anywhere (Any item location can hold an Infant Metroid)" }
          ]
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Movement Tricks & Logic",
      "description": "Step 4: Configure required shinespark tricks and wall jump difficulty in logic",
      "controls": [
        {
          "type": "dropdown",
          "option_key": "ShinesparkTrickDifficulty",
          "label": "Shinespark Trick Difficulty:",
          "choices": [
            { "id": "none", "title": "None (No advanced Speed Booster tricks expected)" },
            { "id": "beginner", "title": "Beginner (Short shinesparks & basic ramp charge storage)" },
            { "id": "advanced", "title": "Advanced (Tight timing shinesparks across hazards)" },
            { "id": "expert", "title": "Expert (Complex multi-room chained shinesparks)" }
          ]
        },
        {
          "type": "dropdown",
          "option_key": "WallJumpTrickDifficulty",
          "label": "Wall Jump Trick Difficulty:",
          "choices": [
            { "id": "none", "title": "None (No single-wall jumping required in logic)" },
            { "id": "required", "title": "Required (Wall jumping expected to reach high ledges)" }
          ]
        }
      ]
