    {
      "num": 5,
      "title": "5. Starting Gear & QoL",
      "description": "Step 5: Starting Energy Tanks, Navigation Convenience, and DeathLink",
      "controls": [
        {
          "type": "slider",
          "option_key": "StartingEnergyTanks",
          "label": "Starting Energy Tanks:",
          "min": 1,
          "max": 10,
          "step": 1,
          "suffix": " Tanks"
