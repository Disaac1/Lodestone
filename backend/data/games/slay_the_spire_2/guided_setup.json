{
  "game_title": "Slay the Spire II",
  "default_config": {
    "characters": [
      "ironclad",
      "silent",
      "defect",
      "regent",
      "necrobinder"
    ],
    "pick_num_characters": 2,
    "num_chars_goal": 0,
    "lock_characters": "locked_random",
    "unlocked_character": "ironclad",
    "progressive_starter_card": false,
    "progressive_starter_relic": false,
    "campfire_sanity": false,
    "gold_sanity": false,
    "potion_sanity": false,
    "shop_sanity": false,
    "neow_sanity": false,
    "death_link": false
  },
  "check_calculator": {
    "base_count": 15,
    "base_label": "Act & Boss Clears",
    "modifiers": [
      {
        "key": "campfire_sanity",
        "label": "Campfire Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "shop_sanity",
        "label": "Shop Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "gold_sanity",
        "label": "Gold Sanity",
        "values": { "true": 15 }
      },
      {
        "key": "potion_sanity",
        "label": "Potion Sanity",
        "values": { "true": 12 }
      },
      {
        "key": "neow_sanity",
        "label": "Neow Sanity",
        "values": { "true": 3 }
      }
    ]
  },
  "required_schema_keys": [
    "characters",
    "pick_num_characters",
    "num_chars_goal",
    "lock_characters",
    "death_link"
  ],
  "steps": [
    {
      "num": 1,
      "title": "1. Character Roster & Goals",
      "description": "Step 1: Choose character roster, heroes played, and victory condition",
      "controls": [
        {
          "type": "multi_select",
          "option_key": "characters",
          "label": "Character Pool (Select heroes allowed in your climb):",
          "columns": 5,
          "items": [
            { "id": "ironclad", "title": "🛡️ Ironclad" },
            { "id": "silent", "title": "🗡️ Silent" },
            { "id": "defect", "title": "⚡ Defect" },
            { "id": "regent", "title": "👑 Regent" },
            { "id": "necrobinder", "title": "💀 Necrobinder" }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "pick_num_characters",
          "label": "Number of Characters to Pick (1 - 5):",
          "min": 1,
          "max": 5,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "slider",
          "option_key": "num_chars_goal",
          "label": "Characters Required for Victory (0 = all picked):",
          "min": 0,
          "max": 5,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "dropdown",
          "option_key": "lock_characters",
          "label": "Character Unlock Logic:",
          "choices": [
            {
              "id": "unlocked",
              "title": "🔓 All Unlocked (Play all picked heroes immediately)"
            },
            {
              "id": "locked_random",
              "title": "🎲 Locked Random (Unlock heroes via multiworld items)"
            },
            {
              "id": "locked_fixed",
              "title": "🔒 Locked Fixed (Start with 1 chosen hero below)"
            }
          ]
        },
        {
          "type": "dropdown",
          "option_key": "unlocked_character",
          "label": "Starting Unlocked Character (if Locked Fixed):",
          "condition": {
            "option_key": "lock_characters",
            "equals": "locked_fixed"
          },
          "choices": [
            { "id": "ironclad", "title": "Ironclad" },
            { "id": "silent", "title": "Silent" },
            { "id": "defect", "title": "Defect" },
            { "id": "regent", "title": "Regent" },
            { "id": "necrobinder", "title": "Necrobinder" }
          ]
        }
      ]
    },
    {
      "num": 2,
      "title": "2. Starter Gear & Difficulty",
      "description": "Step 2: Progressive starter equipment and loadouts",
      "controls": [
        {
          "type": "toggle",
          "option_key": "progressive_starter_card",
          "label": "🃏 Progressive Starter Card (Unlock signature starter card progressively via multiworld)"
        },
        {
          "type": "toggle",
          "option_key": "progressive_starter_relic",
          "label": "🏺 Progressive Starter Relic (Unlock class starter relic via multiworld)"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Sanity Pool",
      "description": "Step 3: Check Density Presets & Individual Sanity Overrides",
      "controls": [
        {
          "type": "preset_grid",
          "columns": 3,
          "presets": [
            {
              "id": "minimal",
              "title": "🏰 Bosses & Campfires",
              "desc": "Minimal check density. Fast-paced run focused on boss drops and campfires.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": false,
                "potion_sanity": false,
                "shop_sanity": false,
                "neow_sanity": false
              }
            },
            {
              "id": "standard",
              "title": "⚖️ Standard Spire",
              "desc": "Balanced multiworld with campfires, gold drops, and Neow blessings.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": true,
                "potion_sanity": false,
                "shop_sanity": false,
                "neow_sanity": true
              }
            },
            {
              "id": "full",
              "title": "🌌 Full Sanity",
              "desc": "Everything is randomized: shops, potions, gold, Neow, and campfires.",
              "values": {
                "campfire_sanity": true,
                "gold_sanity": true,
                "potion_sanity": true,
                "shop_sanity": true,
                "neow_sanity": true
              }
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "campfire_sanity",
          "label": "🔥 Campfire Sanity (Shuffle Rest and Smith abilities into multiworld)"
        },
        {
          "type": "toggle",
          "option_key": "gold_sanity",
          "label": "💰 Gold Sanity (Gold rewards drop multiworld items)"
        },
        {
          "type": "toggle",
          "option_key": "potion_sanity",
          "label": "🧪 Potion Sanity (Potion drops randomized)"
        },
        {
          "type": "toggle",
          "option_key": "shop_sanity",
          "label": "🛒 Shop Sanity (Relics and cards in merchant shops are multiworld checks)"
        },
        {
          "type": "toggle",
          "option_key": "neow_sanity",
          "label": "🐋 Neow Sanity (Neow blessing room checks)"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Multiworld & Links",
      "description": "Step 4: Multiplayer Notifications & DeathLink",
      "controls": [
        {
          "type": "toggle",
          "option_key": "death_link",
          "label": "💀 DeathLink (Dying sends death to your multiworld partners)"
        }
      ]
    }
  ]
}
