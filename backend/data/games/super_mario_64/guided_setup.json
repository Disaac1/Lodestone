{
  "game_title": "Super Mario 64",
  "default_config": {
    "completion_type": 0,
    "amount_of_stars": 120,
    "stars_to_finish": 58,
    "star_door_pacing": "standard",
    "first_bowser_star_door_cost": 12,
    "basement_star_door_cost": 35,
    "second_floor_star_door_cost": 60,
    "mips1_cost": 20,
    "mips2_cost": 50,
    "area_rando": 0,
    "enable_locked_paintings": false,
    "progressive_keys": true,
    "enable_coin_stars": 0,
    "buddy_checks": false,
    "exclamation_boxes": false,
    "enable_move_rando": false,
    "strict_logic_preset": "strict",
    "strict_cap_requirements": true,
    "strict_cannon_requirements": true,
    "strict_move_requirements": true,
    "death_link": false
  },
  "check_calculator": {
    "base_count": 105,
    "base_label": "Course & Secret Stars",
    "modifiers": [
      {
        "key": "enable_coin_stars",
        "label": "100-Coin Stars",
        "values": { "1": 15, "2": 15 }
      },
      {
        "key": "buddy_checks",
        "label": "Bob-omb Buddies",
        "values": { "true": 15 }
      },
      {
        "key": "exclamation_boxes",
        "label": "1Up !-Boxes",
        "values": { "true": 29 }
      }
    ]
  },
  "required_schema_keys": [
    "completion_type",
    "amount_of_stars",
    "stars_to_finish",
    "area_rando",
    "progressive_keys",
    "enable_move_rando",
    "death_link"
  ],
  "steps": [
    {
      "num": 1,
      "title": "1. Goal & Stars",
      "description": "Step 1: Victory Condition, Star Counts & Castle Progression Pacing",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "completion_type",
          "columns": 2,
          "items": [
            {
              "id": 0,
              "title": "👑 Beat Final Bowser",
              "desc": "Defeat Bowser in the Sky (Bowser 3) to clear the game."
            },
            {
              "id": 1,
              "title": "🏰 Defeat All Bowser Stages",
              "desc": "Defeat Bowser in Dark World, Fire Sea & Sky to win."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "amount_of_stars",
          "label": "Total Power Stars in Pool:",
          "min": 35,
          "max": 120,
          "step": 5,
          "suffix": " Stars"
        },
        {
          "type": "slider",
          "option_key": "stars_to_finish",
          "label": "Endless Stairs Requirement:",
          "min": 0,
          "max": 90,
          "step": 5,
          "suffix": "% of Stars"
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "star_door_pacing",
          "label": "Castle Progression Pacing:",
          "choices": [
            {
              "id": "quick",
              "title": "⚡ Quick / Casual (Doors: 8, 30, 50; MIPS: 15, 50)",
              "values": {
                "first_bowser_star_door_cost": 8,
                "basement_star_door_cost": 30,
                "second_floor_star_door_cost": 50,
                "mips1_cost": 15,
                "mips2_cost": 50
              }
            },
            {
              "id": "standard",
              "title": "⚖️ Standard (Doors: 12, 35, 60; MIPS: 20, 50)",
              "values": {
                "first_bowser_star_door_cost": 12,
                "basement_star_door_cost": 35,
                "second_floor_star_door_cost": 60,
                "mips1_cost": 20,
                "mips2_cost": 50
              }
            },
            {
              "id": "vanilla",
              "title": "📜 Vanilla (Doors: 8, 30, 50; MIPS: 15, 50)",
              "values": {
                "first_bowser_star_door_cost": 8,
                "basement_star_door_cost": 30,
                "second_floor_star_door_cost": 50,
                "mips1_cost": 15,
                "mips2_cost": 50
              }
            },
            {
              "id": "custom",
              "title": "🛠️ Custom (Configure Individual Door & MIPS Costs Below)"
            }
          ]
        },
        {
          "type": "slider",
          "option_key": "first_bowser_star_door_cost",
          "label": "First Star Door (Bowser 1):",
          "min": 0,
          "max": 40,
          "step": 1,
          "suffix": "%",
          "condition": {
            "option_key": "star_door_pacing",
            "equals": "custom"
          }
        },
        {
          "type": "slider",
          "option_key": "basement_star_door_cost",
          "label": "Basement Star Door (Bowser 2):",
          "min": 0,
          "max": 50,
          "step": 1,
          "suffix": "%",
          "condition": {
            "option_key": "star_door_pacing",
            "equals": "custom"
          }
        },
        {
          "type": "slider",
          "option_key": "second_floor_star_door_cost",
          "label": "Second Floor Star Door:",
          "min": 0,
          "max": 70,
          "step": 1,
          "suffix": "%",
          "condition": {
            "option_key": "star_door_pacing",
            "equals": "custom"
          }
        },
        {
          "type": "slider",
          "option_key": "mips1_cost",
          "label": "MIPS First Catch Cost:",
          "min": 0,
          "max": 50,
          "step": 1,
          "suffix": " Stars",
          "condition": {
            "option_key": "star_door_pacing",
            "equals": "custom"
          }
        },
        {
          "type": "slider",
          "option_key": "mips2_cost",
          "label": "MIPS Second Catch Cost:",
          "min": 0,
          "max": 80,
          "step": 1,
          "suffix": " Stars",
          "condition": {
            "option_key": "star_door_pacing",
            "equals": "custom"
          }
        }
      ]
    },
    {
      "num": 2,
      "title": "2. World & Entrances",
      "description": "Step 2: Entrance Randomizer & Castle Access Locks",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "area_rando",
          "columns": 3,
          "items": [
            {
              "id": 0,
              "title": "🚪 Vanilla Entrances",
              "desc": "Paintings & levels lead to their original destinations."
            },
            {
              "id": 1,
              "title": "🌀 Course Shuffle",
              "desc": "Randomize course painting destinations (Secrets stay vanilla)."
            },
            {
              "id": 3,
              "title": "🌌 Full Painting & Secret Shuffle",
              "desc": "Randomize all course paintings & secret level entrances!"
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "enable_locked_paintings",
          "label": "🖼️ Enable Locked Paintings (Requires finding painting keys to enter)"
        },
        {
          "type": "toggle",
          "option_key": "progressive_keys",
          "label": "🔑 Progressive Keys (1st Key = Basement, 2nd Key = Upper Floor)"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Location Pools",
      "description": "Step 3: Extra Location Checks, Buddies & Exclamation Boxes",
      "controls": [
        {
          "type": "dropdown",
          "option_key": "enable_coin_stars",
          "label": "100 Coin Stars Pool:",
          "choices": [
            { "id": 0, "title": "Off (100 Coin Stars removed from pool)" },
            { "id": 1, "title": "On (100 Coin Stars in pool & randomized)" },
            { "id": 2, "title": "Vanilla (100 Coin Stars in pool, non-randomized)" }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "buddy_checks",
          "label": "💣 Bob-omb Buddy Checks (Buddies hold items & unlock cannons)"
        },
        {
          "type": "toggle",
          "option_key": "exclamation_boxes",
          "label": "🎁 Randomize 1Up !-Blocks (Adds 29 1Up box locations)"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Mario Moves & Logic",
      "description": "Step 4: Mario Move Randomizer & Logical Strictness",
      "controls": [
        {
          "type": "toggle",
          "option_key": "enable_move_rando",
          "label": "🏃 Enable Move Randomizer (Long Jump, Wall Kick, Triple Jump as items)"
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "strict_logic_preset",
          "label": "Logical Strictness:",
          "choices": [
            {
              "id": "casual",
              "title": "🤸 Casual Logic (Soft requirements; tricks allowed in logic)",
              "values": {
                "strict_cap_requirements": false,
                "strict_cannon_requirements": false,
                "strict_move_requirements": false
              }
            },
            {
              "id": "strict",
              "title": "🎯 Strict / Intended Logic (Caps, cannons, and moves strictly required by logic)",
              "values": {
                "strict_cap_requirements": true,
                "strict_cannon_requirements": true,
                "strict_move_requirements": true
              }
            }
          ]
        }
      ]
    },
    {
      "num": 5,
      "title": "5. Multiworld & Links",
      "description": "Step 5: Multiworld Interactivity & DeathLink",
      "controls": [
        {
          "type": "toggle",
          "option_key": "death_link",
          "label": "💀 DeathLink (Dying sends death to multiworld partners)"
        }
      ]
    }
  ]
}
