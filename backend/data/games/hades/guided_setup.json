  "steps": [
    {
      "num": 1,
      "title": "1. Run Goal & Heat",
      "description": "Step 1: Choose Victory Requirements, Location System & Heat Mechanics",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "location_system",
          "columns": 3,
          "items": [
            {
              "id": 0,
              "title": "🚪 Room Clears",
              "desc": "Clearing any room at each depth gives a location check once."
            },
            {
              "id": 1,
              "title": "🎯 Score / Boss Clears",
              "desc": "Accumulate depth points & defeat underworld bosses for checks."
            },
            {
              "id": 2,
              "title": "⚔️ Room Weapon Based",
              "desc": "Clearing rooms with specific weapons yields individual checks."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "heat_system",
          "label": "Pact of Punishment Heat System:",
          "choices": [
            { "id": 0, "title": "🔄 Reverse Heat (Start high; find pact reduction items in multiworld)" },
            { "id": 1, "title": "🔥 Minimal Heat (Pacts stay constant; cannot be reduced)" },
            { "id": 2, "title": "⚔️ Vanilla Heat (Standard in-game pact selection)" }
          ]
        },
        {
          "type": "slider",
          "option_key": "hades_defeats_needed",
          "label": "Hades Defeats Needed for Victory:",
          "min": 1,
          "max": 10,
          "step": 1,
          "suffix": " Defeat(s)"
        },
        {
          "type": "toggle",
          "option_key": "automatic_rooms_finish_on_hades_defeat",
          "label": "⚡ Auto-Collect Remaining Room Checks on Hades Defeat"
        }
      ]
    },
    {
      "num": 2,
      "title": "2. Weapons & Pact Logic",
      "description": "Step 2: Starting Armament, Boss Pacts and Trap Percentages",
      "controls": [
        {
          "type": "dropdown",
          "option_key": "initial_weapon",
          "label": "Starting Infernal Arm:",
          "choices": [
            { "id": 0, "title": "🗡️ Stygian Blade (Sword)" },
            { "id": 1, "title": "🏹 Heart-Seeker Bow" },
            { "id": 2, "title": "🔱 Eternal Spear" },
            { "id": 3, "title": "🛡️ Shield of Chaos" },
            { "id": 4, "title": "🥊 Twin Fists of Malphon" },
            { "id": 5, "title": "🔫 Adamant Rail (Gun)" }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "reverse_order_em",
          "label": "👑 Reverse Order Extreme Measures (Fight hardest boss variations first)"
        },
        {
          "type": "slider",
          "option_key": "filler_trap_percentage",
          "label": "Filler Trap Weight (Percentage of junk items replaced with traps):",
          "min": 0,
          "max": 20,
          "step": 5,
          "suffix": "%"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Check Pools & Sanity",
      "description": "Step 3: Weaponsanity and Underworld Location Expansion Checks",
      "controls": [
        {
          "type": "toggle",
          "option_key": "weaponsanity",
          "label": "Weaponsanity (Unlock infernal arms via multiworld items)"
        },
        {
          "type": "toggle",
          "option_key": "hidden_aspectsanity",
          "label": "Hidden Aspectsanity (Hidden weapon aspects in item pool)"
        },
        {
          "type": "separator"
        },
        {
          "type": "preset_grid",
          "columns": 2,
          "presets": [
            {
              "id": "core",
              "title": "🏛️ Core Only",
              "desc": "Keepsakes and Mirror talents randomized. Fast and focused multiworld run.",
              "values": {
                "keepsakesanity": true,
                "mirrorsanity": true,
                "fatesanity": false,
                "storesanity": false,
                "fishsanity": false,
                "trovesanity": false
              }
            },
            {
              "id": "full_underworld",
              "title": "🌌 Full Underworld",
              "desc": "All expansion checks active: Fated List, Contractor store, fish, and troves.",
              "values": {
                "keepsakesanity": true,
                "mirrorsanity": true,
                "fatesanity": true,
                "storesanity": true,
                "fishsanity": true,
                "trovesanity": true
              }
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "keepsakesanity",
          "label": "Keepsakesanity (Olympian and Chthonic keepsakes in pool)"
        },
        {
          "type": "toggle",
          "option_key": "mirrorsanity",
          "label": "Mirrorsanity (Mirror of Night talent upgrades in pool)"
        },
        {
          "type": "toggle",
          "option_key": "fatesanity",
          "label": "Fatesanity (Fated List prophecy milestone checks)"
        },
        {
          "type": "toggle",
          "option_key": "storesanity",
          "label": "Storesanity (House Contractor upgrades in pool)"
        },
        {
          "type": "toggle",
          "option_key": "fishsanity",
          "label": "Fishsanity (First catch of each underworld fish species is a check)"
        },
        {
          "type": "toggle",
          "option_key": "trovesanity",
          "label": "Trovesanity (Infernal Trove challenge clears are checks)"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Multiworld & DeathLink",
      "description": "Step 4: DeathLink Configuration & Amnesty",
      "controls": [
        {
          "type": "toggle",
          "option_key": "death_link",
          "label": "💀 Enable DeathLink (Zagreus deaths broadcast to the multiworld)"
        },
        {
          "type": "slider",
          "option_key": "death_link_amnesty",
          "label": "DeathLink Amnesty (Deaths allowed before triggering DeathLink):",
          "min": 0,
          "max": 5,
          "step": 1,
          "suffix": " death(s)"
        },
        {
          "type": "toggle",
          "option_key": "ignore_greece_deaths",
          "label": "🌅 Ignore Greece Deaths (Story deaths on the surface don't trigger DeathLink)"
        }
      ]
    }
  ]
}
