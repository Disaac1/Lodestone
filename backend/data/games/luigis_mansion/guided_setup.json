  "steps": [
    {
      "num": 1,
      "title": "1. Goal & Mansion Mode",
      "description": "Step 1: Choose Mansion Game Mode, End Rank & Movement",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "game_mode",
          "columns": 2,
          "items": [
            {
              "id": 0,
              "title": "🏰 Default Mansion",
              "desc": "Standard exploration. Defeat King Boo to win."
            },
            {
              "id": 1,
              "title": "🧹 Poltergust Hunt",
              "desc": "Short game mode: doors unlocked, find the Poltergust in furniture first."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "choice",
          "option_key": "rank_requirement",
          "label": "Required Mansion Ending Rank:",
          "options": [
            { "id": 0, "name": "Rank H (Any amount of treasure)" },
            { "id": 1, "name": "Rank G" },
            { "id": 2, "name": "Rank F" },
            { "id": 3, "name": "Rank E" },
            { "id": 4, "name": "Rank D" },
            { "id": 5, "name": "Rank C" },
            { "id": 6, "name": "Rank B" },
            { "id": 7, "name": "Rank A (Top Rank - $100M+)" }
          ]
        },
        {
          "type": "choice",
          "option_key": "walk_speed",
          "label": "Luigi Walk Speed:",
          "options": [
            { "id": 0, "name": "Normal Walk Speed" },
            { "id": 1, "name": "Kinda Fast" },
            { "id": 2, "name": "Schmoovin (Fast)" }
          ]
        },
        {
          "type": "checkbox",
          "option_key": "hidden_mansion",
          "label": "Start in Hidden Mansion (Tougher mansion variant)"
        }
      ]
    },
    {
      "num": 2,
      "title": "2. World & Doors",
      "description": "Step 2: Door Randomization, Boo Gates & Upgrades",
      "controls": [
        {
          "type": "choice",
          "option_key": "vacuum_start",
          "label": "Starting Poltergust 3000:",
          "options": [
            { "id": 0, "title": "Start Without Vacuum (Shuffled in Pool)", "name": "Start Without Vacuum (Shuffled in Pool)" },
            { "id": 1, "title": "Start with Poltergust 3000", "name": "Start with Poltergust 3000" }
          ]
        },
        {
          "type": "choice",
          "option_key": "door_rando",
          "label": "Door Randomization:",
          "options": [
            { "id": 0, "title": "Vanilla Doors", "name": "Vanilla Doors" },
            { "id": 1, "title": "Basic Door Randomizer", "name": "Basic Door Randomizer" },
            { "id": 2, "title": "Chaos Door Randomizer", "name": "Chaos Door Randomizer" }
          ]
        },
        {
          "type": "choice",
          "option_key": "boo_radar",
          "label": "Boo Radar Starting State:",
          "options": [
            { "id": 0, "title": "Start with Boo Radar", "name": "Start with Boo Radar" },
            { "id": 1, "title": "Shuffle Boo Radar into Pool", "name": "Shuffle Boo Radar into Pool" },
            { "id": 2, "title": "Exclude Boo Radar (No radar in game)", "name": "Exclude Boo Radar (No radar in game)" }
          ]
        },
        {
          "type": "slider",
          "option_key": "vacuum_upgrades",
          "label": "Poltergust Vacuum Upgrades in Pool:",
          "min": 0,
          "max": 5,
          "step": 1,
          "suffix": " Upgrades"
        },
        {
          "type": "checkbox",
          "option_key": "boo_gates",
          "label": "Boo Gates: Gates require specific Boo counts to pass"
        },
        {
          "type": "slider",
          "option_key": "balcony_boo_count",
          "label": "Boos Required for Balcony Gate:",
          "min": 5,
          "max": 35,
          "step": 1,
          "suffix": " Boos"
        },
        {
          "type": "slider",
          "option_key": "final_boo_count",
          "label": "Boos Required for King Boo Gate:",
          "min": 10,
          "max": 50,
          "step": 1,
          "suffix": " Boos"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Check Pools & Sanity",
      "description": "Step 3: Choose which mansion entities & events are randomized locations",
      "controls": [
        {
          "type": "checkbox",
          "option_key": "boosanity",
          "label": "Boosanity: Shuffle Boos into location pool and item checks"
        },
        {
          "type": "checkbox",
          "option_key": "furnisanity",
          "label": "Furnisanity: Shuffle interactable furniture checks (drawers, cabinets, etc.)"
        },
        {
          "type": "checkbox",
          "option_key": "portrification",
          "label": "Portrification: Shuffle Portrait Ghosts into the item pool"
        },
        {
          "type": "checkbox",
          "option_key": "silver_ghosts",
          "label": "Silver Portrait Rank Checks"
        },
        {
          "type": "checkbox",
          "option_key": "gold_ghosts",
          "label": "Gold Portrait Rank Checks"
        },
        {
          "type": "checkbox",
          "option_key": "speedy_spirits",
          "label": "Speedy Spirits (Blue Ghosts) as checks"
        },
        {
          "type": "checkbox",
          "option_key": "gold_mice",
          "label": "Gold Mice as checks"
        },
        {
          "type": "checkbox",
          "option_key": "toadsanity",
          "label": "Toadsanity: Talking to Toads gives checks"
        },
        {
          "type": "checkbox",
          "option_key": "lightsanity",
          "label": "Lightsanity: Lighting up rooms rewards checks"
        },
        {
          "type": "checkbox",
          "option_key": "walksanity",
          "label": "Walksanity: Visiting rooms rewards checks"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Health & Difficulty",
      "description": "Step 4: Luigi Max Health, Boss Health & Trap Weights",
      "controls": [
        {
          "type": "slider",
          "option_key": "luigi_max_health",
          "label": "Luigi Max Health:",
          "min": 50,
          "max": 200,
          "step": 10,
          "suffix": " HP"
        },
        {
          "type": "slider",
          "option_key": "king_boo_health",
          "label": "King Boo Health:",
          "min": 100,
          "max": 1000,
          "step": 50,
          "suffix": " HP"
        },
        {
          "type": "slider",
          "option_key": "trap_percentage",
          "label": "Trap Item Percentage:",
          "min": 0,
          "max": 40,
          "step": 5,
          "suffix": "%"
        }
      ]
    },
    {
      "num": 5,
      "title": "5. Multiworld & Links",
      "description": "Step 5: DeathLink, TrapLink & EnergyLink",
      "controls": [
        {
          "type": "checkbox",
          "option_key": "death_link",
          "label": "DeathLink: Share deaths with other players in the multiworld"
        },
        {
          "type": "choice",
          "option_key": "trap_link",
          "label": "TrapLink Mode:",
          "options": [
            { "id": 0, "name": "Off" },
            { "id": 1, "name": "Send Only" },
            { "id": 2, "name": "Receive Only" },
            { "id": 3, "name": "Full Bidirectional" }
          ]
        },
        {
          "type": "checkbox",
          "option_key": "energy_link",
          "label": "EnergyLink: Share electrical battery energy across the multiworld"
        }
      ]
    }
